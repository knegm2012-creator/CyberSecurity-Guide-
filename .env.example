# Optional: Gemini API Key for live AI Study Mentor explanations & custom quiz generation.
# Leave unset or keep placeholder when running locally offline—built-in synthesis
# and all 16 verified stage quiz banks work with zero configuration.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Public deployment base URL (defaults to http://localhost:3000 locally).
APP_URL="http://localhost:3000"

# Optional: Directory path for local JSON progress persistence (.data by default).
# CS_ODYSSEY_DATA_DIR=".data"
