# Optional: Server-side Gemini API Key & model for live AI Study Mentor, Web Search grounding, & quizzes.
# Leave unset or keep placeholder when running locally offline — built-in synthesis
# and all 16 verified stage quiz banks work with zero configuration.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-4-hydrogen"

# Optional: Server-side BYOK OpenAI-compatible or local Ollama endpoint (used if GEMINI_API_KEY is unset).
# Local Ollama example: LLM_BASE_URL="http://localhost:11434/v1" LLM_MODEL="llama3.2"
# Remote HTTPS example: LLM_BASE_URL="https://api.openai.com/v1" LLM_API_KEY="sk-your-key-here" LLM_MODEL="gpt-4o-mini"
# LLM_BASE_URL=""
# LLM_API_KEY=""
# LLM_MODEL=""

# Optional: GitHub OAuth App credentials for "Push to GitHub" progress JSON sync.
# Register an OAuth App in GitHub Developer Settings with callback URL: <APP_URL>/api/auth/github/callback
# GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
# GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
# Optional 32+ char key used to sign/encrypt the GitHub OAuth session cookie (defaults to GITHUB_CLIENT_SECRET).
# GITHUB_SESSION_SECRET=""

# Optional: Public deployment base URL (defaults to http://localhost:3000 locally).
APP_URL="http://localhost:3000"

# Optional: Directory path for local JSON progress persistence (.data by default).
# CS_ODYSSEY_DATA_DIR=".data"

